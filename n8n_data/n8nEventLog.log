n      \\\"name\\\":\\\"ItineraryActivities\\\",\\n      \\\"columns\\\":[\\n        { \\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"UUID\\\",\\\"primary\\\":true },\\n        { \\\"name\\\":\\\"itinerary_id\\\",\\\"type\\\":\\\"UUID\\\" },\\n        { \\\"name\\\":\\\"activity_id\\\",\\\"type\\\":\\\"UUID\\\" }\\n      ]\\n    },\\n    {\\n      \\\"name\\\":\\\"AIRecommendations\\\",\\n      \\\"columns\\\":[\\n        { \\\"name\\\":\\\"rec_id\\\",\\\"type\\\":\\\"UUID\\\",\\\"primary\\\":true },\\n        { \\\"name\\\":\\\"travelplan_id\\\",\\\"type\\\":\\\"UUID\\\" },\\n        { \\\"name\\\":\\\"recommendation_text\\\",\\\"type\\\":\\\"TEXT\\\" },\\n        { \\\"name\\\":\\\"confidence\\\",\\\"type\\\":\\\"DECIMAL(5,2)\\\" },\\n        { \\\"name\\\":\\\"generated_at\\\",\\\"type\\\":\\\"TIMESTAMP\\\" }\\n      ]\\n    },\\n    {\\n      \\\"name\\\":\\\"Bookings\\\",\\n      \\\"columns\\\":[\\n        { \\\"name\\\":\\\"booking_id\\\",\\\"type\\\":\\\"UUID\\\",\\\"primary\\\":true },\\n        { \\\"name\\\":\\\"travelplan_id\\\",\\\"type\\\":\\\"UUID\\\" },\\n        { \\\"name\\\":\\\"destination_id\\\",\\\"type\\\":\\\"UUID\\\" },\\n        { \\\"name\\\":\\\"activity_id\\\",\\\"type\\\":\\\"UUID\\\" },\\n        { \\\"name\\\":\\\"booking_date\\\",\\\"type\\\":\\\"TIMESTAMP\\\" },\\n        { \\\"name\\\":\\\"status\\\",\\\"type\\\":\\\"VARCHAR(50)\\\" }\\n      ]\\n    },\\n    {\\n      \\\"name\\\":\\\"Payments\\\",\\n      \\\"columns\\\":[\\n        { \\\"name\\\":\\\"payment_id\\\",\\\"type\\\":\\\"UUID\\\",\\\"primary\\\":true },\\n        { \\\"name\\\":\\\"user_id\\\",\\\"type\\\":\\\"UUID\\\" },\\n        { \\\"name\\\":\\\"booking_id\\\",\\\"type\\\":\\\"UUID\\\" },\\n        { \\\"name\\\":\\\"amount\\\",\\\"type\\\":\\\"DECIMAL(10,2)\\\" },\\n        { \\\"name\\\":\\\"currency\\\",\\\"type\\\":\\\"VARCHAR(3)\\\" },\\n        { \\\"name\\\":\\\"paid_at\\\",\\\"type\\\":\\\"TIMESTAMP\\\" }\\n      ]\\n    },\\n    {\\n      \\\"name\\\":\\\"TravelHistory\\\",\\n      \\\"columns\\\":[\\n        { \\\"name\\\":\\\"history_id\\\",\\\"type\\\":\\\"UUID\\\",\\\"primary\\\":true },\\n        { \\\"name\\\":\\\"user_id\\\",\\\"type\\\":\\\"UUID\\\" },\\n        { \\\"name\\\":\\\"travelplan_id\\\",\\\"type\\\":\\\"UUID\\\" },\\n        { \\\"name\\\":\\\"visit_date\\\",\\\"type\\\":\\\"DATE\\\" },\\n        { \\\"name\\\":\\\"notes\\\",\\\"type\\\":\\\"TEXT\\\" }\\n      ]\\n    }\\n  ],\\n  \\\"relationships\\\":[\\n    { \\\"from_table\\\":\\\"Users\\\",\\\"from_column\\\":\\\"user_id\\\",\\\"to_table\\\":\\\"TravelPlans\\\",\\\"to_column\\\":\\\"user_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"TravelPlans\\\",\\\"from_column\\\":\\\"travelplan_id\\\",\\\"to_table\\\":\\\"Itineraries\\\",\\\"to_column\\\":\\\"travelplan_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"Itineraries\\\",\\\"from_column\\\":\\\"itinerary_id\\\",\\\"to_table\\\":\\\"ItineraryDestinations\\\",\\\"to_column\\\":\\\"itinerary_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"Destinations\\\",\\\"from_column\\\":\\\"destination_id\\\",\\\"to_table\\\":\\\"ItineraryDestinations\\\",\\\"to_column\\\":\\\"destination_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"Itineraries\\\",\\\"from_column\\\":\\\"itinerary_id\\\",\\\"to_table\\\":\\\"ItineraryActivities\\\",\\\"to_column\\\":\\\"itinerary_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"Activities\\\",\\\"from_column\\\":\\\"activity_id\\\",\\\"to_table\\\":\\\"ItineraryActivities\\\",\\\"to_column\\\":\\\"activity_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"TravelPlans\\\",\\\"from_column\\\":\\\"travelplan_id\\\",\\\"to_table\\\":\\\"AIRecommendations\\\",\\\"to_column\\\":\\\"travelplan_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"TravelPlans\\\",\\\"from_column\\\":\\\"travelplan_id\\\",\\\"to_table\\\":\\\"Bookings\\\",\\\"to_column\\\":\\\"travelplan_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"Bookings\\\",\\\"from_column\\\":\\\"booking_id\\\",\\\"to_table\\\":\\\"Payments\\\",\\\"to_column\\\":\\\"booking_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"Users\\\",\\\"from_column\\\":\\\"user_id\\\",\\\"to_table\\\":\\\"Payments\\\",\\\"to_column\\\":\\\"user_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"Users\\\",\\\"from_column\\\":\\\"user_id\\\",\\\"to_table\\\":\\\"TravelHistory\\\",\\\"to_column\\\":\\\"user_id\\\",\\\"type\\\":\\\"one-to-many\\\" },\\n    { \\\"from_table\\\":\\\"TravelPlans\\\",\\\"from_column\\\":\\\"travelplan_id\\\",\\\"to_table\\\":\\\"TravelHistory\\\",\\\"to_column\\\":\\\"travelplan_id\\\",\\\"type\\\":\\\"one-to-many\\\" }\\n  ],\\n  \\\"indexes\\\":[\\n    { \\\"table\\\":\\\"Users\\\",\\\"columns\\\":[\\\"user_id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"Users\\\",\\\"columns\\\":[\\\"email\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"Destinations\\\",\\\"columns\\\":[\\\"destination_id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"Activities\\\",\\\"columns\\\":[\\\"activity_id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"TravelPlans\\\",\\\"columns\\\":[\\\"travelplan_id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"Itineraries\\\",\\\"columns\\\":[\\\"itinerary_id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"ItineraryDestinations\\\",\\\"columns\\\":[\\\"id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"ItineraryActivities\\\",\\\"columns\\\":[\\\"id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"AIRecommendations\\\",\\\"columns\\\":[\\\"rec_id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"Bookings\\\",\\\"columns\\\":[\\\"booking_id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"Payments\\\",\\\"columns\\\":[\\\"payment_id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"TravelHistory\\\",\\\"columns\\\":[\\\"history_id\\\"],\\\"unique\\\":true },\\n    { \\\"table\\\":\\\"ItineraryDestinations\\\",\\\"columns\\\":[\\\"itinerary_id\\\",\\\"destination_id\\\"],\\\"unique\\\":false },\\n    { \\\"table\\\":\\\"ItineraryActivities\\\",\\\"columns\\\":[\\\"itinerary_id\\\",\\\"activity_id\\\"],\\\"unique\\\":false }\\n  ],\\n  \\\"queries\\\":[\\n    {\\n      \\\"name\\\":\\\"GetUserTravelPlansWithDetails\\\",\\n      \\\"sql\\\":\\\"SELECT tp.name AS plan_name, d.name AS destination_name, a.name AS activity_name \\\\n       FROM TravelPlans tp\\\\n       JOIN Itineraries it ON tp.travelplan_id = it.travelplan_id\\\\n       JOIN ItineraryDestinations idt ON it.itinerary_id = idt.itinerary_id\\\\n       JOIN Destinations d ON idt.destination_id = d.destination_id\\\\n       JOIN ItineraryActivities ia ON it.itinerary_id = ia.itinerary_id\\\\n       JOIN Activities a ON ia.activity_id = a.activity_id\\\\n       WHERE tp.user_id = :user_id;\\\"\\n    },\\n    {\\n      \\\"name\\\":\\\"InsertNewTravelPlan\\\",\\n      \\\"sql\\\":\\\"INSERT INTO TravelPlans(user_id, name, status, created_at) VALUES существует (?, ?, ?, CURRENT_TIMESTAMP);\\\"\\n    },\\n    {\\n      \\\"name\\\":\\\"GetLatestAIRecommendation\\\",\\n      \\\"sql\\\":\\\"SELECT recommendation_text, confidence, generated_at \\\\n       FROM AIRecommendations\\\\n       WHERE travelplan_id = :travelplan_id\\\\n       ORDER BY generated_at DESC\\\\n       LIMIT 1;\\\"\\n    }\\n  ]\\n}\",\"generationInfo\":{\"finish_reason\":\"stop\"}}]]},\"tokenUsage\":{\"completionTokens\":2899,\"promptTokens\":121,\"totalTokens\":3020}}}"}}

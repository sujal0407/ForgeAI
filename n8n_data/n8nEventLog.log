n    \\\"User selects a destination card → navigate to DestinationDetails\\\",\\n    \\\"User taps ‘Plan Itinerary’ → open ItineraryView with AI-suggested schedule\\\",\\n    \\\"Wishlist activities or ask AI via AIChat to modify timeline\\\",\\n    \\\"User reviews final itinerary → proceed to BookingConfirmation\\\",\\n    \\\"Enter payment → confirmation and receive travel package\\\",\\n    \\\"Optional: Go to ProfileSettings to update preferences\\\"\\n  ],\\n  \\\"animations\\\": [\\n    {\\n      \\\"component\\\": \\\"SearchBar\\\",\\n      \\\"animation\\\": \\\"slideDown\\\",\\n      \\\"duration\\\": 300\\n    },\\n    {\\n      \\\"component\\\": azért\\\",\\n      \\\"animation\\\": \\\"fadeIn\\\",\\n      \\\"duration\\\": 400\\n    },\\n    {\\n      \\\"component\\\": \\\"ChatBubbleList\\\",\\n      \\\"animation\\\": \\\" أعمال slideUp\\\",\\n      \\\"duration\\\": 250\\n    },\\n    {\\n      \\\"component\\\": \\\"Card\\\",\\n      \\\"onHover\\\": \\\"scaleUp(1.05)\\\",\\n      \\\"duration\\\": 200\\n    }\\n  ]\\n}\",\"generationInfo\":{\"finish_reason\":\"stop\"}}]]},\"tokenUsage\":{\"completionTokens\":934,\"promptTokens\":132,\"totalTokens\":1066}}}"}}

t user profile\\\"\\n    },\\n    {\\n      \\\"method\\\": \\\"GET\\\",\\n      \\\"path\\\": \\\"/destinations\\\",\\n      \\\"description\\\": \\\"List destinations with optional filters (budget, season, interests)\\\"\\n    },\\n    {\\n      \\\"method\\\": \\\"GET\\\",\\n      \\\"path\\\": \\\"/destinations/:id\\\",\\n      \\\"description\\\": \\\"Get detailed destination info\\\"\\n    },\\n    {\\n      \\\"method\\\": \\\"POST\\\",\\n      \\\"path\\\": \\\"/recommendations\\\",\\n      \\\"description\\\": \\\"Submit travel preferences, receive ranked recommendations\\\"\\n    },\\n    {\\n      \\\"method\\\": \\\"POST\\\",\\n      \\\"path\\\": \\\"/itineraries\\\",\\n      \\\"description\\\": \\\"Create an itinerary from selected destinations\\\"\\n    },\\n    {\\n      \\\"method\\\": \\\"GET\\\",\\n      \\\"path\\\": \\\"/itineraries/:id\\\",\\n      \\\"description\\\": \\\"Retrieve a specific itinerary\\\"\\n    },\\n    {\\n      \\\"method\\\": \\\"PUT\\\",\\n      \\\"path\\\": \\\"/itineraries/:id\\\",\\n      \\\"description\\\": \\\"Update itinerary details or add/remove destinations\\\"\\n    },\\n    {\\n      \\\"method\\\": \\\"DELETE\\\",\\n      \\\"path\\\": \\\"/itineraries/:id\\\",\\n      \\\"description\\\": \\\"Delete an itinerary\\\"\\n    },\\n    {\\n      \\\"method\\\": \\\"POST\\\",\\n      \\\"path\\\": \\\"/bookings\\\",\\n      \\\"description\\\": \\\"Create ranging booking for flights, hotels, and activities\\\"\\n    },\\n    {\\n      \\\"method\\\": \\\"GET\\\",\\n      \\\"path\\\": \\\"/bookings/:id\\\",\\n      \\\"description\\\": \\\"Get booking status and details\\\"\\n    }\\n  ],\\n  \\\"authentication\\\": {\\n    \\\"strategy\\\": \\\"JWT with refresh tokens\\\",\\n    \\\"social_login\\\": \\\"Google OAuth 2.0\\\"\\n  },\\n  \\\"business_logic\\\": [\\n    {\\n      \\\"name\\\": \\\"PreferenceProcessing\\\",\\n      \\\"description\\\": \\\"Persist user travel preferences and map to tags\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"DestinationFiltering\\\",\\n      \\\"description\\\": \\\"Filter destinations by budget, season, للدخرج\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"RecommendationEngine\\\",\\n      \\\"description\\\": \\\"ML/KNN model ranking destinations based on similarity to prefs\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"ItineraryPlanner\\\",\\n      \\\"description\\\": \\\"Generate day‑by‑day schedule with time windows, transport and activity sequencing\\\"\\n    },\\n    {\\n      \\\"_fragment\\\": \\\"BudgetOptimizer\\\",\\n      \\\" COP\\\": \\\"Calculate total cost, suggest cheaper alternatives, track spend thresholds\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"BookingOrchestration\\\",\\n      \\\"description\\\": \\\"Interface with flight, hotel and activity APIs to create/modify bookings\\\"\\n    }\\n  ],\\n  \\\"services\\\": [\\n    \\\"AuthService\\\",\\n    \\\"UserService\\\",\\n    \\\"DestinationService\\\",\\n    \\\"RecommendationService\\\",\\n    \\\"ItineraryService\\\",\\n    \\\"BookingService\\\",\\n    \\\"NotificationService\\\"\\n  ],\\n  \\\"folder_structure\\\": [\\n    \\\"src/\\\",\\n    \\\"src/main.ts\\\",\\n    \\\"src/app.module.ts\\\",\\n    \\\"src/common/\\\",\\n    \\\"src/common/pipes/\\\",\\n    \\\"src/common/guards/\\\",\\n    \\\"src/common/interceptors/\\\",\\n    \\\"src/auth/\\\",\\n    \\\"src/auth/auth.controller.ts\\\",\\n    \\\"src/auth/auth.service.ts\\\",\\n    \\\"src/users/\\\",\\n    \\\"src/users/user.controller.ts\\\",\\n    \\\"src/users/user.service.ts\\\",\\n    \\\"src/destinations/\\\",\\n    \\\"src/destinations/destination.controller.ts\\\",\\n    \\\"src/destinations/destination.service.ts\\\",\\n    \\\"src/recommendations/\\\",\\n    \\\"src/recommendations/recommendation.controller.ts\\\",\\n    \\\"src/recommendations/recommendation.service.ts\\\",\\n    \\\"src/itineraries/\\\",\\n    \\\"src/itineraries/itinerary.controller.ts\\\",\\n    \\\"src/itinerarie